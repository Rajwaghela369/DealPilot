# Copy to .env at the repo root and adjust. Docker Compose auto-loads this
# file (it lives next to docker-compose.yml) for ${VAR} substitution --
# separate from backend/.env, which the FastAPI app itself reads.
#
# Keep POSTGRES_PASSWORD in sync with the DATABASE_URL password in
# backend/.env.example if you also run the backend outside Docker.

POSTGRES_USER=dealpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dealpilot

# Host-side ports (left-hand side of the "host:container" mapping). Adjust if
# these ever clash with something else already running on your machine.
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

PGADMIN_DEFAULT_EMAIL=admin@dealpilot.dev
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_HOST_PORT=5051

# --- Object storage ---
# Uploaded documents live in MinIO. Keep these in sync with backend/.env's
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY if you run the backend outside Docker.
MINIO_ROOT_USER=dealpilot
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=dealpilot-documents
MINIO_API_PORT=9000
